{
  "name": "smtstudio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && tsx --test tests/*.test.ts",
    "test:auth": "tsx --test tests/server-env.test.ts tests/auth-config.test.ts",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "storage:setup": "tsx scripts/setup-storage.ts",
    "auth:generate": "auth generate --config ./lib/auth-cli.ts --adapter drizzle --dialect postgresql --output ./db/schema/auth.ts --yes"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.3",
    "@supabase/supabase-js": "^2.115.0",
    "better-auth": "^1.7.3",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.2.0",
    "next": "16.3.4",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-icons": "^5.7.0",
    "server-only": "^0.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "auth": "^1.7.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
